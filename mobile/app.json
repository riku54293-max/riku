{
  "expo": {
    "name": "女装スタイリング",
    "slug": "crossdressing-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "写真を撮影してスタイリング変換に使用します",
        "NSPhotoLibraryUsageDescription": "写真ライブラリから画像を選択してスタイリング変換に使用します"
      }
    },
    "android": {
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    }
  }
}
