# Google Gemini APIキー（画像生成に使用）
GEMINI_API_KEY=

# 使用するGeminiの画像生成モデル名（利用可能なモデルはAPIキーの契約により異なるため要確認）
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# サーバーポート
PORT=4000

# CORSで許可するオリジン（モバイルアプリのExpo開発サーバー等、カンマ区切りで複数指定可）
CORS_ORIGIN=*

# アップロード可能な最大ファイルサイズ（バイト）。デフォルト20MB
MAX_UPLOAD_BYTES=20971520

# ClamAVデーモンのホスト/ポート（未設定の場合はヒューリスティックスキャンのみで動作）
CLAMAV_HOST=
CLAMAV_PORT=3310
